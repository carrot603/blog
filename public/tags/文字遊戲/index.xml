      const inp=document.createElement("input");
      inp.maxLength=2; inp.autocomplete="off"; inp.autocapitalize="off"; inp.spellcheck=false;
      inp.setAttribute("aria-label","第"+(r+1)+"列第"+(c+1)+"欄");
      cells[k].el=inp; cells[k].d=d; d.appendChild(inp);
      if(nums[k]){const s=document.createElement("span");s.className="n";s.textContent=nums[k];d.appendChild(s)}
      
      inp.onfocus=()=>{cur=k;if(!W[act].cells.includes(k))act=cells[k].words[0];render()};
      inp.onpointerdown=()=>{wasFocused=document.activeElement===inp};
      inp.onclick=()=>{const ws=cells[k].words;if(wasFocused&&ws.length>1){act=ws[(ws.indexOf(act)+1)%ws.length];render()}};
      inp.oninput=()=>{
        const v=inp.value.replace(/[^a-zA-Z]/g,"").slice(-1).toUpperCase();inp.value=v;
        if(v){const cs=W[act].cells,i=cs.indexOf(k);if(i>=0&&i<cs.length-1)cells[cs[i+1]].el.focus()}
        check();
      };
      inp.onkeydown=e=>{
        const dirs={ArrowUp:[-1,0],ArrowDown:[1,0],ArrowLeft:[0,-1],ArrowRight:[0,1]};
        if(dirs[e.key]){e.preventDefault();let[a,b]=dirs[e.key],rr=r,cc=c;for(let s=0;s<12;s++){rr+=a;cc+=b;if(cells[rr+","+cc]){cells[rr+","+cc].el.focus();break}}}
        else if(e.key==="Backspace"&&!inp.value){e.preventDefault();const cs=W[act].cells,i=cs.indexOf(k);if(i>0){const p=cells[cs[i-1]].el;p.value="";p.focus();check()}}
      };
    }
    grid.appendChild(d);
  }

  const cl=document.getElementById("clues");
  ["橫","直","斜"].forEach(dir=>{
    const h=document.createElement("h3");h.textContent={橫:"橫向 →",直:"直向 ↓",斜:"斜向 ↘"}[dir];cl.appendChild(h);
    const ul=document.createElement("ul");
    W.map((w,i)=>[w,i]).filter(([w])=>w.dir===dir).sort((x,y)=>x[0].num-y[0].num).forEach(([w,i])=>{
      const li=document.createElement("li");li.id="q"+i;
      li.innerHTML=`<b>${w.num}</b><span class="t">${w.q}</span><span class="len">${w.a.length} 個字母</span>`;
      li.onclick=()=>{act=i;const k=w.cells.find(k=>!cells[k].el.value)||w.cells[0];cells[k].el.focus();render()};
      ul.appendChild(li);
    });
    cl.appendChild(ul);
  });

  const st=w=>{const v=w.cells.map(k=>cells[k].el.value.toLowerCase());return v.includes("")?"p":v.join("")===w.a?"ok":"bad"};
  function render(){
    const aw=W[act];
    for(const k in cells){
      const c=cells[k],cn=c.d.classList,s=c.words.map(i=>W[i]);
      cn.toggle("act",aw.cells.includes(k));cn.toggle("cur",k===cur);
      cn.toggle("ok",s.some(w=>w.done));cn.toggle("bad",!s.some(w=>w.done)&&s.some(w=>st(w)==="bad"));
    }
    W.forEach((w,i)=>{const li=document.getElementById("q"+i);if(li){li.classList.toggle("act",i===act);li.classList.toggle("done",w.done)}});
    const d=W.filter(w=>w.done).length;
    document.getElementById("prog").textContent=`已完成 ${d} / ${W.length}`;
    document.getElementById("win").style.display=d===W.length?"block":"none";
  }

  let tt;
  function toast(t){const e=document.getElementById("toast");e.textContent=t;e.classList.add("show");clearTimeout(tt);tt=setTimeout(()=>e.classList.remove("show"),2200)}
  function check(){
    W.forEach(w=>{
      const s=st(w)==="ok";
      if(s&&!w.done){w.done=true;toast(W.every(x=>x.done)?"🎉 全部答對了！太棒了！":`✓ 答對了！${w.A}（${w.q}）`)}
      else if(!s&&w.done)w.done=false;
    });
    render();
  }

  document.getElementById("hint").onclick=()=>{
    const k=W[act].cells.find(k=>cells[k].el.value.toLowerCase()!==cells[k].ans);
    if(k){cells[k].el.value=cells[k].ans.toUpperCase();cells[k].el.focus();check()}
  };
  document.getElementById("reset").onclick=()=>{
    for(const k in cells)cells[k].el.value="";W.forEach(w=>w.done=false);render();cells[W[act].cells[0]].el.focus();
  };
  render();
});
</script>

